# Vite environment variables for Google Sheets
# Copy to .env and set your values

# Google Sheets API Key (optional - only needed if not using Apps Script)
VITE_GOOGLE_SHEETS_API_KEY=your_google_api_key_here

# Your Google Spreadsheet ID
VITE_GOOGLE_SHEETS_ID=1DRjVUz5Twf1KnSEnEedauviAIX7ka7GpLgKqhlW853Q

# Google Apps Script Web App URL (required)
VITE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycbyZGr8TJLA_nrPmmG3tcGPFZuoxq0qK55vcL9YQcJB7OBjv5P7ZQm_zWEVv7Onx_8kc/exec

# Write token for secure POST requests (must match token in Apps Script)
VITE_SHEETS_WRITE_TOKEN=acts_africa_f9c732777f663f515fc9b8b6dce3c21e3e0a7d5f249f6e3ab5c5173cb97126d8

# Instructions:
# 1. Copy this file to .env
# 2. Replace the WRITE_TOKEN with the same value you used in Google Apps Script
# 3. If you changed the Web App URL, update VITE_SHEETS_WEBAPP_URL
# 4. Never commit .env to version control
